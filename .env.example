# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agendamento_db

# JWT & Security
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256

# Observability: Grafana Loki
# Optional: if not set (any of the 3 vars missing), observability is disabled (safe default)
# To enable, generate API key in Grafana Cloud → Administration → API Keys
# URL format: https://logs-prod-XXX.grafana.net/loki/api/v1/push
# The push API requires HTTP Basic Auth (user_id:api_token), not Bearer alone.
# Find GRAFANA_LOKI_USER_ID in Grafana Cloud Portal → your stack → Loki → Details
GRAFANA_LOKI_URL=
GRAFANA_LOKI_API_TOKEN=
GRAFANA_LOKI_USER_ID=

# Other services
EVOLUTION_API_URL=http://localhost:8080
GOOGLE_CALENDAR_API_KEY=your-api-key-here

# Tenant limits
TENANT_LIMIT_WORST_CASE_CALLS_PER_MESSAGE=3
TENANT_LIMIT_AVERAGE_CALLS_PER_MESSAGE=3
